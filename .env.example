# =============================================================================
# FortiClient VPN & Carbonio 2FA Yapılandırma Dosyası
# =============================================================================

# 1. VPN Sunucu Bilgileri
VPN_SERVER=vpn.sirketiniz.com:443
VPN_USER=adiniz.soyadiniz
VPN_PASS=vpn_parolaniz

# Windows için FortiSSLVPNcli.exe yolu (Windows kullanılıyorsa)
FORTICLIENT_PATH=C:\Program Files (x86)\Fortinet\SslvpnClient\FortiSSLVPNcli.exe

# macOS için openfortivpn sudo parolası (isteğe bağlı; otomatik root erişimi için)
MAC_SUDO_PASS=

# 2. Carbonio E-posta (IMAP SSL 993) Bilgileri
IMAP_SERVER=mail.sirketiniz.com
IMAP_PORT=993
IMAP_USER=adiniz.soyadiniz@sirketiniz.com
IMAP_PASS=eposta_parolaniz
MAIL_TIMEOUT=60

# 3. Canlılık ve Kopma İzleme (Keep-Alive)
PING_TARGET=10.0.0.1
PING_INTERVAL=15
MAX_PING_FAILS=3
RECONNECT_DELAY=15
